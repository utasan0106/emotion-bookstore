{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "disposition",
    "summary",
    "issues",
    "fix_prompt",
    "evidence_required",
    "protected_scope_violation",
    "runtime_visual_evidence_present",
    "source_authority_uncertain"
  ],
